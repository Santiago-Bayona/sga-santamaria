# Origen del backend, sin barra final. Las rutas del cliente ya empiezan por /api.
# En Vercel: https://sga-api-santamaria.onrender.com
# En local puedes omitirla: Vite reenvía /api a http://localhost:8080
VITE_API_URL=http://localhost:8080

# Token público de Mapbox (pk....). Sin él, el mapa muestra la dirección y un enlace a OpenStreetMap.
VITE_MAPBOX_TOKEN=
