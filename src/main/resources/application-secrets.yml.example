# Plantilla versionada. Cópiela como application-secrets.yml en esta misma carpeta
# (ese archivo NO se versiona: está en .gitignore) y ponga una clave aleatoria
# de mínimo 32 caracteres (256 bits) para HS256.
#   Git Bash:    openssl rand -base64 48
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# En despliegue, la variable de entorno SGA_JWT_SECRET tiene prioridad sobre este archivo.
sga:
  secreto:
    jwt: reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres
    # Solo si se enciende la IA real (sga.ia.habilitada=true y sga.ia.proveedor=openai-compatible).
    # La variable de entorno SGA_IA_CLAVE tiene prioridad.
    # ia-clave: reemplace-por-la-clave-del-proveedor-de-ia
    # Solo si el correo real está encendido (sga.correo.proveedor=brevo). La variable SGA_BREVO_CLAVE tiene prioridad.
    # brevo-clave: xkeysib-reemplace-por-su-api-key-de-brevo
